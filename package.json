{
  "name": "coastal-ai",
  "version": "1.7.0-dev",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "start": "concurrently --kill-others-on-fail --prefix-colors \"cyan,magenta\" --names \"core,web\" \"node packages/core/dist/main.js\" \"pnpm --filter web dev\"",
    "desktop": "pnpm --filter @coastal-ai/desktop dev",
    "start:fresh": "pnpm build && pnpm start",
    "stop": "node -e \"const f=require('fs'),p=require('path');const pid=f.existsSync(p.join('data','.server.pid'))&&f.readFileSync(p.join('data','.server.pid'),'utf8').trim();if(pid)try{process.kill(Number(pid))}catch(e){console.log('No running process found')}else console.log('No PID file found — use Ctrl+C')\"",
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "test:sandbox:start": "node scripts/sandbox-cli.js start",
    "test:sandbox:stop": "node scripts/sandbox-cli.js stop",
    "test:sandbox:clean": "node scripts/sandbox-cli.js clean",
    "test:sandbox:logs": "node scripts/sandbox-cli.js logs",
    "test:sandbox:status": "node scripts/sandbox-cli.js status"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/client-preset": "^4.1.0",
    "@graphql-codegen/typescript": "^5.0.0",
    "@graphql-codegen/typescript-operations": "^5.0.0",
    "@graphql-codegen/typescript-resolvers": "^5.0.0",
    "concurrently": "^9.2.1",
    "turbo": "^2.0.0",
    "typescript": "~5.9.3",
    "wait-on": "^9.0.5"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "onnxruntime-node",
      "protobufjs"
    ],
    "overrides": {
      "@xmldom/xmldom": ">=0.9.9",
      "loader-utils": ">=2.0.4"
    }
  }
}
